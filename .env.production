# ============================================
# TORRENTTWIST - ENVIRONNEMENT PRODUCTION
# ============================================

# ============================================
# APPLICATION
# ============================================
NODE_ENV=production
NEXT_PUBLIC_APP_NAME=TorrentTwist
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_API_URL=https://api.torrenttwist.com

# ============================================
# SÉCURITÉ - JWT (GÉNÉRER UN SECRET UNIQUE)
# ============================================
JWT_SECRET=GENERER_UN_SECRET_UNIQUE_AVEC_openssl_rand_-base64_32
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ============================================
# BASE DE DONNÉES - PostgreSQL
# ============================================
DATABASE_URL=postgresql://user:password@production-db:5432/torrenttwist

# ============================================
# AUTHENTIFICATION ADMIN
# ============================================
ADMIN_EMAIL=admin@torrenttwist.com
ADMIN_PASSWORD=CHANGER_CE_MOT_DE_PASSE
ADMIN_NAME=Administrateur

# ============================================
# SESSIONS
# ============================================
SESSION_TIMEOUT=1800000
MAX_LOGIN_ATTEMPTS=3
LOGIN_ATTEMPT_WINDOW=900000

# ============================================
# EMAIL (SMTP)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=contact@torrenttwist.com
SMTP_PASS=xxx
SMTP_FROM=no-reply@torrenttwist.com

# ============================================
# PAIEMENT - Stripe
# ============================================
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxx
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ============================================
# STOCKAGE - Cloudinary
# ============================================
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=torrenttwist
CLOUDINARY_API_KEY=xxx
CLOUDINARY_API_SECRET=xxx

# ============================================
# ANALYTICS
# ============================================
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# ============================================
# CACHE - Redis
# ============================================
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=xxx

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX=50

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=error
LOG_FILE=/var/log/torrenttwist/app.log

# ============================================
# CORS
# ============================================
CORS_ORIGIN=https://torrenttwist.com
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS

# ============================================
# API
# ============================================
API_RATE_LIMIT=50
API_RATE_LIMIT_WINDOW=60000
API_VERSION=v1

# ============================================
# FEATURES
# ============================================
NEXT_PUBLIC_ENABLE_AI=true
NEXT_PUBLIC_ENABLE_CHAT=true
NEXT_PUBLIC_ENABLE_REVIEWS=true






# 🔥 Utiliser les clés LIVE (pas sandbox)
NEXT_PUBLIC_FEDAPAY_PUBLIC_KEY=pk_live_4MdzQsZ3C6FA_pN0YzqZOZ
8y
NEXT_PUBLIC_FEDAPAY_ENVIRONMENT=live
NEXT_PUBLIC_FEDAPAY_CURRENCY=XOF

# Clé secrète pour le backend (webhook)
FEDAPAY_SECRET_KEY=sk_live_vK9dNoAN1tQN6XQ5rIHMsp
