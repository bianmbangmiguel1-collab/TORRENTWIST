# ============================================
# TORRENTTWIST - ENVIRONNEMENT LOCAL
# ============================================
# Ce fichier contient les variables d'environnement pour le développement.
# NE PAS COMMITTER CE FICHIER DANS LE REPOSITORY.

# ============================================
# APPLICATION
# ============================================
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=TorrentTwist
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_APP_URL=http://localhost:5000

# ============================================
# 🔥 SÉCURITÉ - JWT (UNIFORME)
# ============================================
# ⚠️ UTILISER UN SEUL SECRET POUR TOUT LE SYSTÈME
# Générer un secret avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=torrenttwist_super_secret_key_2026
JWT_EXPIRES_IN=100000y          # 100 ANS - JAMAIS EXPIRER
JWT_REFRESH_EXPIRES_IN=100000y  # 100 ANS

# ============================================
# ADMIN - Identifiants par défaut
# ============================================
ADMIN_EMAIL=admin@torrenttwist.com
ADMIN_PASSWORD=Admin123!
ADMIN_NAME=Administrateur TorrentTwist

# ============================================
# BASE DE DONNÉES - SQLite
# ============================================
# Le backend utilise SQLite, pas besoin de PostgreSQL pour le développement.
DB_TYPE=sqlite
DB_FILE=./database.sqlite
DATABASE_URL=file:./torrenttwist-backend/database.sqlite

# ============================================
# BACKEND API
# ============================================
BACKEND_PORT=5000
BACKEND_URL=http://localhost:5000

# ============================================
# SESSIONS
# ============================================
SESSION_TIMEOUT=1800000  # 30 minutes en millisecondes
MAX_LOGIN_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW=900000  # 15 minutes

# ============================================
# IA - OpenRouter
# ============================================
OPENROUTER_API_KEY=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
USE_MOCK_AI=false

# ============================================
# IA - DeepSeek
# ============================================
DEEPSEEK_API_KEY=sk-c51d544453194cbb8bd02c193124d749

# ============================================
# EMAIL (SMTP) - Optionnel
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=no-reply@torrenttwist.com

# ============================================
#   FEDAPAY
# ============================================
FEDAPAY_PUBLIC_KEY=pk_sandbox_IFlqM6QBcscPy0GqK5zclFke
FEDAPAY_SECRET_KEY=sk_sandbox_yDDL8BGkzlEnXZGOj-iHjVyN
# Callbacks
FEDAPAY_CALLBACK_URL=http://localhost:3000/payment/success

# ============================================
# PAIEMENT - LeekPay
# ============================================
LEEKPAY_API_KEY=pk_test_xxx
LEEKPAY_SECRET_KEY=sk_test_xxx
LEEKPAY_WEBHOOK_SECRET=whsec_xxx
LEEKPAY_BASE_URL=https://api.leekpay.com/v1

# ============================================
# PAIEMENT - Mobile Money (Orange, MTN) - Mode Test
# ============================================
ORANGE_MONEY_API_KEY=xxx
ORANGE_MONEY_SECRET=xxx
MTN_MOMO_API_KEY=xxx
MTN_MOMO_SECRET=xxx

# ============================================
# STOCKAGE - Cloudinary (Images)
# ============================================
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=torrenttwist
CLOUDINARY_API_KEY=xxx
CLOUDINARY_API_SECRET=xxx

# ============================================
# ANALYTICS
# ============================================
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# ============================================
# CACHE - Redis (Optionnel)
# ============================================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW=60000  # 1 minute
RATE_LIMIT_MAX=100  # Requêtes max par fenêtre

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=debug
LOG_FILE=logs/app.log

# ============================================
# CORS
# ============================================
CORS_ORIGIN=http://localhost:3000,https://torrenttwist.com
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS

# ============================================
# SÉCURITÉ SUPPLEMENTAIRE
# ============================================
BCRYPT_SALT_ROUNDS=10
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_SPECIAL=true
PASSWORD_REQUIRE_NUMBER=true
PASSWORD_REQUIRE_UPPERCASE=true

# ============================================
# FICHIERS
# ============================================
MAX_FILE_SIZE=5242880  # 5MB
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,image/gif

# ============================================
# API
# ============================================
API_RATE_LIMIT=100
API_RATE_LIMIT_WINDOW=60000
API_VERSION=v1

# ============================================
# FEATURES - FLAGS
# ============================================
NEXT_PUBLIC_ENABLE_AI=true
NEXT_PUBLIC_ENABLE_CHAT=true
NEXT_PUBLIC_ENABLE_REVIEWS=true

