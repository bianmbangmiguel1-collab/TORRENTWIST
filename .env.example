# ============================================
# TORRENTTWIST - EXEMPLE DE CONFIGURATION
# ============================================
# Copiez ce fichier en .env.local et remplissez les valeurs

# ============================================
# APPLICATION
# ============================================
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=TorrentTwist
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_API_URL=http://localhost:3000

# ============================================
# SÉCURITÉ - JWT
# ============================================
# Générer un secret avec: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-secret-key-here
JWT_EXPIRES_IN=7d

# ============================================
# BASE DE DONNÉES
# ============================================
DATABASE_URL=postgresql://user:password@localhost:5432/database_name

# ============================================
# AUTHENTIFICATION ADMIN
# ============================================
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-admin-password
ADMIN_NAME=Administrator

# ============================================
# SESSIONS
# ============================================
SESSION_TIMEOUT=1800000
MAX_LOGIN_ATTEMPTS=5

# ============================================
# EMAIL (SMTP)
# ============================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=your-password
SMTP_FROM=no-reply@example.com

# ============================================
# PAIEMENT
# ============================================
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx

# ============================================
# STOCKAGE
# ============================================
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=xxx
CLOUDINARY_API_SECRET=xxx

# ============================================
# CACHE
# ============================================
REDIS_URL=redis://localhost:6379

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX=100