# ============================================
# TORRENTTWIST - ENVIRONNEMENT DE DÉVELOPPEMENT
# ============================================

# ============================================
# APPLICATION
# ============================================
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=TorrentTwist (Dev)
NEXT_PUBLIC_APP_VERSION=1.0.0-dev
NEXT_PUBLIC_API_URL=http://localhost:3000

# ============================================
# SÉCURITÉ - JWT
# ============================================
JWT_SECRET=dev-secret-key-never-use-in-production-2024
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ============================================
# BASE DE DONNÉES - PostgreSQL
# ============================================
DATABASE_URL=postgresql://postgres:password@localhost:5432/torrenttwist_dev

# ============================================
# AUTHENTIFICATION ADMIN (DÉVELOPPEMENT)
# ============================================
ADMIN_EMAIL=admin@torrenttwist.com
ADMIN_PASSWORD=Admin123!
ADMIN_NAME=Administrateur Dev

# ============================================
# SESSIONS
# ============================================
SESSION_TIMEOUT=3600000  # 1 heure en dev
MAX_LOGIN_ATTEMPTS=10
LOGIN_ATTEMPT_WINDOW=900000

# ============================================
# EMAIL (SMTP) - Mailtrap pour le dev
# ============================================
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=xxx
SMTP_PASS=xxx
SMTP_FROM=no-reply@torrenttwist.dev

# ============================================
# PAIEMENT - Stripe (Mode Test)
# ============================================
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ============================================
# STOCKAGE - Cloudinary (Mode Test)
# ============================================
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=torrenttwist
CLOUDINARY_API_KEY=xxx
CLOUDINARY_API_SECRET=xxx

# ============================================
# ANALYTICS (Désactivé en dev)
# ============================================
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=

# ============================================
# CACHE - Redis
# ============================================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ============================================
# RATE LIMITING (Désactivé en dev)
# ============================================
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX=1000

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=debug
LOG_FILE=logs/dev.log

# ============================================
# CORS (Dev - Permissif)
# ============================================
CORS_ORIGIN=*
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS

# ============================================
# API
# ============================================
API_RATE_LIMIT=1000
API_RATE_LIMIT_WINDOW=60000
API_VERSION=v1

# ============================================
# FEATURES (Tout activé en dev)
# ============================================
NEXT_PUBLIC_ENABLE_AI=true
NEXT_PUBLIC_ENABLE_CHAT=true
NEXT_PUBLIC_ENABLE_REVIEWS=true
NEXT_PUBLIC_ENABLE_DEBUG=true